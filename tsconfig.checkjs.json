{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "maxNodeModuleJsDepth": 0,
    "types": []
  },
  "include": [
    "shared/engine-core/**/*.js",
    "shared/comfort-visual-prefs.js",
    "shared/constants.js",
    "shared/contrast-utils.js",
    "shared/mode-exclusivity.js"
  ]
}
